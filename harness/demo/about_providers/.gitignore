# 真实密钥配置（**不入 git**）——复制 providers/ 后填入真实 api_key
#
#   cp -r providers providers.local
#   # 编辑 providers.local/minimax.toml 与 providers.local/deepseek.toml 的 api_key
#   .venv/bin/python harness/demo/about_providers/provider.py \
#       --config harness/demo/about_providers/providers.local
#
# 本文件遵循设计文档 §9.2「api_key 仅 TOML 明文，不读环境变量」——
# demo 不会从任何环境变量里取 key。
providers.local/
